# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        wget \
        curl \
        libopencv-dev \
        libgtest-dev \
        libgmock-dev \
        libturbojpeg0-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.23
RUN wget -q https://go.dev/dl/go1.23.0.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.23.0.linux-amd64.tar.gz \
    && rm go1.23.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Install Rust (for tokenizer-rs)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Download ONNX Runtime (GPU)
RUN wget -q "https://github.com/microsoft/onnxruntime/releases/download/v1.24.4/onnxruntime-linux-x64-gpu-1.24.4.tgz" \
    && tar -xzf onnxruntime-linux-x64-gpu-1.24.4.tgz -C /opt \
    && mv /opt/onnxruntime-linux-x64-gpu-1.24.4 /opt/onnxruntime \
    && rm onnxruntime-linux-x64-gpu-1.24.4.tgz
ENV ONNXRUNTIME_ROOT=/opt/onnxruntime

WORKDIR /src
COPY . .

# Build Rust tokenizer
RUN cargo build --release --manifest-path tokenizer-rs/Cargo.toml

# Build C++ with CUDA + ONNX + nvJPEG
RUN cmake -S . -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DINFER_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES="75;86;89;90;120" \
        -DONNXRUNTIME_ROOT=/opt/onnxruntime \
    && cmake --build build --target infer_api -j$(nproc)

# Build Go binary
RUN CGO_ENABLED=1 \
    CGO_CFLAGS="-I/src/cpp/include" \
    CGO_LDFLAGS="-L/src/build/cpp/api -linfer_api -Wl,-rpath,/usr/local/lib/infergo" \
    go build -C go \
        -ldflags "-s -w" \
        -o /out/infergo \
        ./cmd/infergo

# Collect all shared libs
RUN mkdir -p /out/lib && \
    cp /src/build/cpp/api/libinfer_api.so /out/lib/ && \
    cp /src/build/cpp/onnx/libinfer_onnx.so /out/lib/ 2>/dev/null || true && \
    cp /src/build/cpp/tensor/libinfer_tensor.so /out/lib/ 2>/dev/null || true && \
    cp /src/tokenizer-rs/target/release/libinfer_tokenizer.so /out/lib/ 2>/dev/null || true && \
    cp /src/build/cpp/tokenizer/libinfer_tokenizer_cpp.so /out/lib/ 2>/dev/null || true && \
    cp /opt/onnxruntime/lib/libonnxruntime*.so* /out/lib/ 2>/dev/null || true


# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
# Use runtime image (no compiler, no headers) — much smaller than devel
FROM nvidia/cuda:12.4.0-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        libgomp1 \
        libopencv-core4.5d \
        libopencv-imgproc4.5d \
        libopencv-imgcodecs4.5d \
        libturbojpeg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/infergo     /usr/local/bin/infergo
COPY --from=builder /out/lib/*.so*   /usr/local/lib/infergo/

RUN echo "/usr/local/lib/infergo" > /etc/ld.so.conf.d/infergo.conf && ldconfig

VOLUME ["/models"]

EXPOSE 9090

# nvidia-container-runtime sets CUDA_VISIBLE_DEVICES; pass --provider cuda at runtime
ENTRYPOINT ["infergo"]
CMD ["serve", "--model", "/models/model.gguf", "--provider", "cuda", "--port", "9090", "--gpu-layers", "999"]
